[GeneralSettings]
MesVersion=4
HandleExceptions=1
LinkInCode=1
AppendMapFileToBinary=1
NoOwnMadExceptSettings=0
CheckFileCrc=1
AutomaticallySaveBugReport=1
AutomaticallyMailBugReport=0
AutoMailProgressBox=0
CopyBugReportToClipboard=0
ShowPleaseWaitBox=1
AutomaticallyContinueApplication=0
AutomaticallyRestartApplication=0
AutomaticallyCloseApplication=0
SendInBackground=1
UploadViaHttp=0
MailAsSmtpServer=0
MailAsSmtpClient=0
MailViaMapi=0
MailViaMailto=0
BugReportFile=bugreport.log
AppendBugReports=1
ShowExceptionBox=1
MailSubject=YTTrans bug report
MailBody=Please find the bug report attached.

[BugReport]
ListThreads=1
ListModules=1
ListHardware=1
ShowCpuRegisters=1
ShowStackDump=1
Disassembly=1
HideUglyItems=0
ShowRelativeAddrs=1
ShowRelativeLines=1
EnabledPlugins=modules|processes|hardware

[Filters]
GeneralDontCreateBugReport=0
GeneralDontCreateScreenshot=1
GeneralDontSuspendThreads=0
GeneralDontCallHandlers=0
GeneralShowBox=0
